{
  "name": "onthehook-genlayer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:contract": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:unit": "node --test tests/*.test.mjs",
    "test:static": "node tools/verify-project.mjs",
    "test": "npm run test:contract && npm run test:unit && npm run test:static",
    "verify:source": "node tools/verify-source.mjs",
    "verify:onchain": "node tools/verify-onchain.mjs",
    "probe:calldata": "node tools/probe-calldata.mjs",
    "check": "npm run verify:source && npm test && npm run build"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "lucide-react": "0.548.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "2.29.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.9.3",
    "vite": "6.0.0"
  }
}
